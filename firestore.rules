rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // This matches the administrator email used by Voyage Tech's website code.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email in [
          'Voyagestyles@gmail.com',
          'voyagestyles@gmail.com'
        ];
    }

    function ownsResource() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    // Product catalogue: visitors can browse; only the administrator can change it.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Categories are public to browse and administrator-managed.
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Storefront settings are displayed publicly; only admin may change them.
    match /storeSettings/{settingId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Customers need to read a known coupon code at checkout.
    // Only admin can list, create, deactivate, or delete coupons.
    // A customer transaction may increment usedCount by exactly one and
    // cannot change the coupon's other fields.
    match /coupons/{couponId} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, delete: if isAdmin();

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.active == true
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['usedCount', 'updatedAt'])
          && request.resource.data.usedCount == resource.data.usedCount + 1
        );
    }

    // One redemption record per order reference, created by that customer.
    match /couponRedemptions/{redemptionId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.orderReference == redemptionId
        && request.resource.data.couponCode is string;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Customers can submit and view only their own orders.
    // Admin can view and update all orders from the admin dashboard.
    match /orders/{orderId} {
      allow create: if isAdmin();
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Public order tracking exposes only safe progress fields for a known reference.
    // Customers can create a tracking record only for an order they own; only admins can update it.
    match /publicOrderTracking/{trackingId} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin()
        || (
          signedIn()
          && request.resource.data.reference == trackingId
          && request.resource.data.orderId is string
          && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
          && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.uid == request.auth.uid
          && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.reference == trackingId
          && request.resource.data.keys().hasOnly(['reference', 'orderId', 'status', 'paymentStatus', 'total', 'itemsText', 'fulfillment', 'createdAt', 'updatedAt'])
        );
      allow update, delete: if isAdmin();
    }

    // AFFILIATE APPLICATIONS: customers may submit and read their own application.
    match /affiliateApplications/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending';
      allow get, list: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow update, delete: if isAdmin();
    }

    // AFFILIATE PROFILES: private dashboard data belongs to the affiliate and admin.
    match /affiliateProfiles/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Affiliate codes can be checked by checkout but cannot be enumerated.
    match /affiliateCodes/{code} {
      allow get: if resource.data.status == 'active';
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    // Commission history is visible only to the affiliate and administrator.
    match /affiliateCommissions/{commissionId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // Payout records are controlled by the administrator.
    match /affiliatePayouts/{payoutId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // Save-to-Buy plans belong to the customer who submitted them.
    match /savePlans/{planId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Anonymous visitor analytics: public browsers may submit limited, non-identifying events; only admin can read them.
    match /visitorAnalytics/{eventId} {
      allow create: if request.resource.data.keys().hasOnly(['sessionId', 'source', 'medium', 'campaign', 'page', 'createdAt'])
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() <= 80
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 80
        && request.resource.data.medium is string
        && request.resource.data.medium.size() <= 100
        && request.resource.data.campaign is string
        && request.resource.data.campaign.size() <= 150
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    // Everything not explicitly listed above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}